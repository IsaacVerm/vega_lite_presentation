{
        "$schema": "https: //vega.github.io/schema/vega-lite/v6.json",
        "description": "A simple bar chart with embedded data.",
        "data": {
          "url": "kerncijfers_economische_migratie.csv",
          "format": { "type": "dsv", "delimiter": ";"
        }
    },
        "mark": "bar",
        "encoding": {
          "x": {"field": "NATIONALITEIT", "type": "ordinal", "sort": "-y"
        },
          "y": {"field": "NATIONALITEIT", "aggregate": "count"
        }
    }
}